# OpenAI API key for GPT models (required)
OPENAI_API_KEY=open-api-key-here

# Tavily API key for web search (required)
TAVILY_API_KEY=tavily-api-key-here

# GPT Researcher configuration
# Embedding model
# Only used when CONTEXT_FILTER=embeddings (gpt-researcher 0.16.0+)
EMBEDDING=openai:text-embedding-3-small

# Context filter: picks which scraped passages the LLM gets to read.
# auto (default) uses Jev when TYPESAFE_API_KEY is set, otherwise local
# keyword (BM25) ranking. Other modes: jev, keyword, embeddings, none.
# Set to embeddings to keep the behaviour of gpt-researcher before 0.16.0.
# See https://docs.gptr.dev/docs/gpt-researcher/gptr/context-filter
# CONTEXT_FILTER=auto
# Optional: TypeSafe API key enabling the Jev usefulness filter
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# LLM for strategic research
STRATEGIC_LLM=openai:gpt-4o-mini # To increase speed, use gpt-4o-mini

# Maximum number of research iterations
# (To increase speed, use 2)
MAX_ITERATIONS=2

# Optional example: Anthropic API key if using Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server configuration
LOG_LEVEL=INFO
PORT=8000 